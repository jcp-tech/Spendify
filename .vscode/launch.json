{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Application Debugger: ADK",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "args": [
                "web"
            ],
            "cwd": "${workspaceFolder}/adk_pipeline",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv-windows/Scripts/python.exe", // Windows
            // "python": "${workspaceFolder}/venv-linux/bin/python", // Linux
            "env": {
            }
        },
        {
            "name": "Python Debugger: Bot",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/discord_bot/bot.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv-windows/Scripts/python.exe", // Windows
            // "python": "${workspaceFolder}/venv-linux/bin/python", // Linux
            "env": {
                // Add any environment variables needed for the Bot here
                // e.g., "DISCORD_TOKEN": "your_token_here"
            }
        },
        {
            "name": "Python Debugger: Flask UI & API",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/flask_api/main_api.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv-windows/Scripts/python.exe", // Windows
            // "python": "${workspaceFolder}/venv-linux/bin/python", // Linux
            "env": {
                // Add any environment variables needed for the API here
                // e.g., "API_PORT": "8000"
            }
        }
    ],
    "compounds": [
        {
            "name": "RUN ALL",
            "configurations": ["Application Debugger: ADK", "Python Debugger: Bot", "Python Debugger: Flask UI & API"],
            "stopAll": true
        }
    ]
}